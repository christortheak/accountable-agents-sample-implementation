    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "reset": "node scripts/setup.js --reset",
    "demo": "node src/demo/server.js",
    "aaf": "node src/cli/aaf.js",
    "rp": "node src/rp/standalone.js"
  },
  "license": "MIT",
  "bin": {
    "aaf": "src/cli/aaf.js"
  }
}
