{
  "name": "aaf-reference",
  "version": "0.1.0",
  "description": "Reference implementation of the Accountable Agents Framework: registries, record keepers, and a transaction simulator.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node scripts/start.js",
